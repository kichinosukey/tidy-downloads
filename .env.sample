# apfel (Apple on-device model via OpenAI-compatible API)
LOCAL_LLM_MODEL=apple-foundationmodel
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=not-needed
LOCAL_LLM_API_MODE=chat_completions

